# Use the SAME NEW Top Cloud project in both applications. Never copy Uganda credentials.
VITE_SUPABASE_URL=https://YOUR_TOP_CLOUD_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
# Server-side contact endpoint (same project/key; never a service-role key)
SUPABASE_URL=https://YOUR_TOP_CLOUD_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
# Server-side email settings for both booking and inquiry notifications
SMTP_HOST=mail.topcloudtours.com
SMTP_PORT=587
SMTP_USER=info@topcloudtours.com
# Local env files require quotes around passwords containing #.
# Use the exact mailbox password. Cloudflare secret values need no wrapping quotes.
SMTP_PASSWORD="REPLACE_WITH_EXACT_MAILBOX_PASSWORD"
SMTP_FROM_EMAIL="Top Cloud Tours <info@topcloudtours.com>"
CONTACT_RECIPIENT_EMAILS=info@topcloudtours.com
# Resend is used whenever its API key is configured. SMTP is used when it is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Top Cloud Tours <info@topcloudtours.com>"
CONTACT_EMAIL=info@topcloudtours.com
# Optional endpoint override. Leave blank for the same-origin Pages Function.
VITE_CONTACT_API_URL=
