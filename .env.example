VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
# Server-side contact endpoint (same project/key; never a service-role key)
SUPABASE_URL=https://YOUR_TOP_CLOUD_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_TOP_CLOUD_KEY
